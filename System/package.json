{
  "name": "jaturamitr-rov",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ระบบควบคุม OBS และ overlay สำหรับการแข่งขัน ROV (BO3) ออก Facebook Live",
  "scripts": {
    "dev": "concurrently -n HUB,WEB -c cyan,magenta \"npm:dev:hub\" \"npm:dev:web\"",
    "dev:hub": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "heroes": "node scripts/import-heroes.mjs",
    "heroes:fetch": "node scripts/fetch-heroes.mjs",
    "heroes:check": "node scripts/check-hero-images.mjs",
    "fix:obs-size": "node scripts/fix-overlay-size.mjs",
    "obs:refresh": "node scripts/refresh-overlays.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "obs-websocket-js": "^5.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
